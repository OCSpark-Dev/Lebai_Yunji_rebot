{"id":10243,"name":"apriltag-offset","description":"","source":"{\"safety\":true,\"version\":1.4,\"pose\":{\"acc\":50,\"v\":50,\"time\":0,\"br\":1},\"loopTo\":1,\"signals\":[],\"timeline\":[],\"children\":[]}","end_lua":null,"lua_source":"tag_id = 11\n\n\n-- 初始化\napriltag = scene(\"10253\")\ntag_pose = nil --tag中心位置\ngood_pose = nil --真正抓取点\n\n-- 第一步，到达tag前端20cm处\nset_claw(0, 100)\ntags = apriltag.find_tags()\nprint(\"find tags:\", tags)\ntag = tags[tostring(tag_id)]\nif not tag\nthen\n    error(\"not find tag\")\nend\ntag_pose = lua_pose(tag)\npose = pose_times(tag_pose, {0, 0, -0.2, 0, 0, 0}) --tag前端20cm处\nsuccess, result = pcall(function() move_hybrid(pose, 0.1, 0.1, 0, 0) end)\nif not success then\n    print(\"failed to move:\", result)\nelse\n    sync() -- 等待运动完成\nend\n\n--第二步，示教到真正抓取点\nteach_mode()\n\n--第三步，按下肩部按钮确认\nwhile true\ndo\n    if lebai:get_di(\"SHOULDER\", 0) ~= 0\n    then\n        end_teach_mode()\n        break\n    else\n        wait(20)\n    end\nend\ngood_pose = get_actual_tcp_pose()\nprint(\"tag_pose:\", tag_pose)\nprint(\"good_pose:\", good_pose)\nprint(\"------\")\noffset = pose_times(pose_inverse(tag_pose), good_pose)\nprint(\"offset:\", offset)\nprint(\"verify:\", pose_times(tag_pose, offset))\n","progress_json":null,"status":1,"type":3,"image":null,"create_time":"2023-11-01T18:41:16.607738275+08:00","update_time":"2024-08-01T16:58:53.176840987+08:00","export_time":"2024-08-01T17:27:04.569291188+08:00","robot_model":"LM3","arm_sn":"C02205010039XX","main_box_sn":"R02105010025XX","ds_version":"2.4.20+24061317","rc_version":"3.1.33+24080108"}