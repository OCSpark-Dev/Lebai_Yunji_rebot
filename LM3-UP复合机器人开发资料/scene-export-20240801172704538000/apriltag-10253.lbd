{"id":10253,"name":"apriltag","description":"","source":"{\"safety\":true,\"version\":1.4,\"pose\":{\"acc\":50,\"v\":50,\"time\":0,\"br\":1},\"loopTo\":1,\"signals\":[],\"timeline\":[],\"children\":[]}","end_lua":null,"lua_source":"disable_auto_sync()\n\nway = \"modbus\" -- \"modbus\" / \"signal\"\nrun_test = false\n\nif way == \"signal\"\nthen\n    camera_ip = \"192.168.4.46\"\n    sid = 13\n    camera = lebai_sdk.connect(camera_ip, true)\nend\nif way == \"modbus\"\nthen\n    mb = modbus.new_flange()\n    mb:set_slave(0x07)\nend\n\n\nfunction i16_to_u16(i)\n    if i \u003c 0 then\n        return i + 65536\n    else\n        return i\n    end\nend\nfunction u16_to_i16(x)\n    if x \u003e 32767 then\n        return x - 65536\n    else\n        return x\n    end\nend\nfunction pose2reg(pose)\n    x = i16_to_u16(math.floor(pose[1] * 1000))\n    y = i16_to_u16(math.floor(pose[2] * 1000))\n    z = i16_to_u16(math.floor(pose[3] * 1000))\n    rz = i16_to_u16(math.floor(pose[4]/(2*math.pi)*65536))\n    ry = i16_to_u16(math.floor(pose[5]/(2*math.pi)*65536))\n    rx = i16_to_u16(math.floor(pose[6]/(2*math.pi)*65536))\n    return {x, y, z, rz, ry, rx}\nend\nfunction reg2pose(reg, start)\n    x = u16_to_i16(reg[start+0]) / 1000\n    y = u16_to_i16(reg[start+1]) / 1000\n    z = u16_to_i16(reg[start+2]) / 1000\n    rz = u16_to_i16(reg[start+3])/65536*(2*math.pi)\n    ry = u16_to_i16(reg[start+4])/65536*(2*math.pi)\n    rx = u16_to_i16(reg[start+5])/65536*(2*math.pi)\n    return {x=x, y=y, z=z, rz=rz, ry=ry, rx=rx}\nend\nfunction find_tags()\n    if way == \"signal\"\n    then\n        camera:set_signal(sid, 1)\n        while camera:get_signal(sid)\u003e0\n        do\n            wait(100)\n        end\n        tags = camera:get_item(\"plugin_apriltag_tags\")['value']\n        return json.decode(tags)\n    end\n    if way == \"modbus\"\n    then\n        fpose = get_actual_flange_pose()\n        mb:write_multiple_registers(302, pose2reg(fpose))\n        mb:write_single_register(300, 1)\n        while mb:read_holding_registers(300, 2)[1]~=0\n        do\n            wait(100)\n        end\n        num = mb:read_holding_registers(301, 2)[1]\n        tags = {}\n        for i=1,num\n        do\n            tag_data = mb:read_holding_registers(301+10*i, 7)\n            tags[tostring(tag_data[1])] = reg2pose(tag_data, 2)\n        end\n        return tags\n    end\nend\n\nif run_test\nthen\n    tag_id = 1\n    start_time=timestamp()\n    tags = find_tags()\n    print(\"time to find_tags:\", timestamp()-start_time)\n    print(tags)\n    print(tags[tag_id])\n    print(tags[tostring(tag_id)])\nend\n\nreturn {find_tags=find_tags}\n","progress_json":null,"status":1,"type":3,"image":null,"create_time":"2023-11-01T18:41:16.607738275+08:00","update_time":"2024-08-01T15:34:47.802038614+08:00","export_time":"2024-08-01T17:27:04.573143497+08:00","robot_model":"LM3","arm_sn":"C02205010039XX","main_box_sn":"R02105010025XX","ds_version":"2.4.20+24061317","rc_version":"3.1.33+24080108"}