{"id":10252,"name":"抓标签","description":"","source":"{\"safety\":true,\"version\":1.4,\"pose\":{\"acc\":50,\"v\":50,\"time\":0,\"br\":1},\"loopTo\":1,\"signals\":[],\"timeline\":[],\"children\":[]}","end_lua":null,"lua_source":"disable_auto_sync()\napriltag = scene(\"10253\")\n\ncell2tag = {0.006882736373352516,0.0056327989433465064,-0.07775308832791732,-0.040681812818944924,0.01672128272179878,0.019841581106630143}\t\ntag_id = 11\n\nset_claw(0, 100)--开夹爪\nsync()\n\n\ntags = apriltag.find_tags()\ntag = tags[tostring(tag_id)]\nif not tag\nthen\n    error(\"not find tag\")\nend\ntag_pose = lua_pose(tag)\n\ncurrent_pose = get_actual_tcp_pose()\ncell_pose = pose_times(tag_pose, cell2tag)--夹取点\nmove_hybrid(cell_pose, 0.1, 0.1, 0, 0)\nsync()\nset_claw(100, 0)--夹取\nmove_hybrid(current_pose, 0.1, 0.1, 0, 0)\n","progress_json":null,"status":1,"type":3,"image":null,"create_time":"2023-11-01T18:41:16.607738275+08:00","update_time":"2024-08-01T17:00:18.344777241+08:00","export_time":"2024-08-01T17:27:04.572680983+08:00","robot_model":"LM3","arm_sn":"C02205010039XX","main_box_sn":"R02105010025XX","ds_version":"2.4.20+24061317","rc_version":"3.1.33+24080108"}